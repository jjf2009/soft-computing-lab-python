[TITLE]
Selftest drainage network (tiny, for pipeline smoke test)

[OPTIONS]
FLOW_UNITS           CMS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             03:00:00
SWEEP_START          01/01
SWEEP_END            12/31
DRY_DAYS             0
REPORT_STEP          00:05:00
WET_STEP             00:01:00
DRY_STEP             01:00:00
ROUTING_STEP         10
ALLOW_PONDING        NO
INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  H-W
LINK_OFFSETS         DEPTH
MIN_SLOPE            0

[RAINGAGES]
;;Name  Format    Interval SCF  Source
RG1      INTENSITY 0:05     1.0  TIMESERIES TS1

[SUBCATCHMENTS]
;;Name Raingage Outlet Area %Imperv Width Slope CurbLen
S1     RG1      J1     2.0  50      100   0.5   0
S2     RG1      J2     2.0  50      100   0.5   0
S3     RG1      J3     2.0  50      100   0.5   0

[SUBAREAS]
;;Subcatch N-Imperv N-Perv S-Imperv S-Perv PctZero RouteTo
S1  0.01 0.1 0.05 0.05 25 OUTLET
S2  0.01 0.1 0.05 0.05 25 OUTLET
S3  0.01 0.1 0.05 0.05 25 OUTLET

[INFILTRATION]
;;Subcatch MaxRate MinRate Decay DryTime MaxInfil
S1 3.0 0.5 4 7 0
S2 3.0 0.5 4 7 0
S3 3.0 0.5 4 7 0

[JUNCTIONS]
;;Name Elev MaxDepth InitDepth SurDepth Aponded
J1 10 2 0 0 0
J2 9  2 0 0 0
J3 8  2 0 0 0
J4 7  2 0 0 0

[OUTFALLS]
;;Name Elev Type StageData Gated
OUT 5 FREE NO

[CONDUITS]
;;Name FromNode ToNode Length Roughness InOffset OutOffset InitFlow MaxFlow
C1 J1 J2 100 0.013 0 0 0 0
C2 J2 J3 100 0.013 0 0 0 0
C3 J1 J3 150 0.013 0 0 0 0
C4 J3 J4 100 0.013 0 0 0 0
C5 J2 J4 140 0.013 0 0 0 0
C6 J4 OUT 100 0.013 0 0 0 0

[XSECTIONS]
;;Link Shape Geom1 Geom2 Geom3 Geom4 Barrels
C1 CIRCULAR 0.5 0 0 0 1
C2 CIRCULAR 0.5 0 0 0 1
C3 CIRCULAR 0.5 0 0 0 1
C4 CIRCULAR 0.5 0 0 0 1
C5 CIRCULAR 0.5 0 0 0 1
C6 CIRCULAR 0.6 0 0 0 1

[TIMESERIES]
;;Name Date       Time  Value
TS1 01/01/2020 00:00 0
TS1 01/01/2020 00:30 30
TS1 01/01/2020 01:00 60
TS1 01/01/2020 01:30 20
TS1 01/01/2020 02:00 5
TS1 01/01/2020 03:00 0

[COORDINATES]
;;Node X   Y
J1 0   100
J2 100 100
J3 100 0
J4 200 0
OUT 300 0
